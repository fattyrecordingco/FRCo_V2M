{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VINS",
  "version": "0.1.4",
  "identifier": "co.fattyrecording.vins",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VINS",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "app"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["../../backend"],
    "windows": {
      "wix": {
        "language": "en-US",
        "upgradeCode": "9AA9D773-5AF4-4A53-AD08-0F6A5B99C0DA"
      }
    }
  }
}


