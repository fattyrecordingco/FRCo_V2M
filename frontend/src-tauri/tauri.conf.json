{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VINS",
  "version": "0.1.3",
  "identifier": "co.fattyrecording.vins",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VINS",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "app"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["../../backend"]
  }
}


